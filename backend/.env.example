# StockFlow Backend Environment Variables

# Application
PROJECT_NAME="StockFlow - Inventory Management System"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockflow_db
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/stockflow_db"

# CORS Configuration (Comma-separated list or JSON array of origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
