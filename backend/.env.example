PROJECT_NAME="StockFlow - Inventory Management System"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=False
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database Configuration (Psycopg 3 Driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg://postgres:password@localhost:5432/stockflow_db"

# Connection Pooling Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS Configuration (Comma-separated list or JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
    