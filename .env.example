# StockFlow Root Environment Configuration Template
# Copy this file to .env or configure in backend/.env and frontend/.env

# Backend Configuration
PROJECT_NAME="StockFlow - Inventory Management System"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=False
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database (Psycopg 3)
DATABASE_URL="postgresql+psycopg://postgres:password@localhost:5432/stockflow_db"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "https://stock-flow-git-main-kanthu2005.vercel.app"]
