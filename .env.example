# StockFlow Root Environment Configuration Example
# Copy this file to .env or configure in backend/.env and frontend/.env

# Backend Configuration
PROJECT_NAME="StockFlow - Inventory Management System"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockflow_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockflow_db"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000"
